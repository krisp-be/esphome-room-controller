# Copy this file to secrets.yaml (same folder as the device config) and fill it in.
# secrets.yaml is ignored by git: never commit it.
wifi_ssid: "your-network"
wifi_password: "your-wifi-password"
# Password of the fallback access point the board opens when it cannot reach Wi-Fi (min. 8 characters).
fallback_ap_password: "change-me-please"
# Password for over-the-air updates.
ota_password: "change-me-too"
# Home Assistant API encryption key (32 bytes, base64). Generate one with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
